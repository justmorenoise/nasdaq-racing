# Supabase (real-data feed). Open the app with ?feed=supabase to use it.
# The anon key is safe for the browser; the Finnhub key lives only as an
# Edge Function secret on the server, never here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Broker affiliate deep-links (the "Investi" CTAs). All optional — without them
# the CTAs point at the public eToro pages (untracked). With an eToro affiliate
# program, set the tracked deep-link template (keep the {symbol} placeholder)
# and your partner/sub id (appended to every link for attribution).
VITE_AFFILIATE_TEMPLATE=https://www.etoro.com/markets/{symbol}
VITE_AFFILIATE_SIGNUP=https://www.etoro.com/
VITE_AFFILIATE_SUBID=
